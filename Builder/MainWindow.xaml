<Window x:Class="Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Builder.ViewModels"
        xmlns:local="clr-namespace:Builder"
        Title="Builder"
        Icon="pack://application:,,,/Builder.ico"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit" CloseOnClickAway="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Height="28" Background="{DynamicResource ThemeTitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <Button Grid.Column="0" Click="OpenSettings_Click"
                    Style="{StaticResource MaterialDesignToolButton}"
                    Height="28" Padding="8,0" ToolTip="設定">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Cog" Width="14" Height="14" Foreground="{DynamicResource ThemeSubText}" />
                    <TextBlock Text="設定" FontSize="11" Foreground="{DynamicResource ThemeSubText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Title -->
            <TextBlock Grid.Column="1" Text="Builder" FontSize="11" Foreground="{DynamicResource ThemeMutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <!-- Window Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="MinimizeButton_Click" Style="{StaticResource MaterialDesignToolButton}"
                        Width="40" Height="28" ToolTip="最小化">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="13" Height="13" Foreground="{DynamicResource ThemeSubText}" />
                </Button>
                <Button Click="MaximizeButton_Click" Style="{StaticResource MaterialDesignToolButton}"
                        Width="40" Height="28" ToolTip="最大化">
                    <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="13" Height="13" Foreground="{DynamicResource ThemeSubText}" />
                </Button>
                <Button Click="CloseButton_Click" Style="{StaticResource MaterialDesignToolButton}"
                        Width="40" Height="28" ToolTip="閉じる">
                    <materialDesign:PackIcon Kind="WindowClose" Width="13" Height="13" Foreground="{DynamicResource ThemeSubText}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Project List -->
            <DockPanel Grid.Column="0" Background="{DynamicResource ThemeSidebar}">
                <DockPanel DockPanel.Dock="Top" Margin="10,8">
                    <TextBlock Text="プロジェクト" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding AddProjectFromGithubCommand}"
                                ToolTip="GitHubからクローン" Width="26" Height="26">
                            <materialDesign:PackIcon Kind="Github" Width="15" Height="15" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding AddProjectCommand}"
                                ToolTip="フォルダから追加" Width="26" Height="26" Margin="2,0,0,0">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding RemoveProjectCommand}"
                                ToolTip="削除" Width="26" Height="26" Margin="2,0,0,0">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Filter TextBox -->
                <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="13" Height="13"
                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                            Foreground="{DynamicResource ThemeMutedText}"
                                            IsHitTestVisible="False" />
                    <TextBox Grid.Column="1"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="フィルター"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="{DynamicResource ThemeSplitter}"
                             Padding="0,2,0,2" />
                </Grid>

                <ListBox x:Name="ProjectListBox"
                         ItemsSource="{Binding FilteredProjects}"
                         SelectedItem="{Binding SelectedProject, Mode=OneWay}"
                         SelectionChanged="ProjectListBox_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         Padding="4,0"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ProjectList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ProjectList_PreviewMouseMove"
                         PreviewMouseRightButtonDown="ProjectList_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="ProjectList_PreviewMouseRightButtonUp"
                         Drop="ProjectList_Drop"
                         DragOver="ProjectList_DragOver"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="AllowDrop" Value="True" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0"
                                                         Kind="{Binding IconKind}"
                                                         Width="16" Height="16"
                                                         VerticalAlignment="Top"
                                                         Margin="0,2,8,0"
                                                         Foreground="{DynamicResource ThemeSubText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock local:TextHighlighter.Text="{Binding Name}"
                                               local:TextHighlighter.Query="{Binding DataContext.HighlightText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="13" />
                                    <TextBlock local:TextHighlighter.Text="{Binding FolderPath}"
                                               local:TextHighlighter.Query="{Binding DataContext.HighlightText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ThemeMutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ThemeSplitter}" />

            <!-- Right -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Settings -->
                <StackPanel Grid.Row="0" Margin="14,8,14,4"
                            Visibility="{Binding HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <!-- Branch Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                Visibility="{Binding HasCurrentBranch, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- Branch switch popup -->
                        <materialDesign:PopupBox x:Name="BranchPopupBox"
                                                 PlacementMode="BottomAndAlignLeftEdges"
                                                 StaysOpen="False"
                                                 Padding="0"
                                                 ToolTip="ブランチを切り替え"
                                                 materialDesign:RippleAssist.IsDisabled="True"
                                                 materialDesign:RippleAssist.Feedback="Transparent">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SourceBranch" Width="15" Height="15"
                                                             Foreground="{DynamicResource ThemeAccent}"
                                                             VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CurrentBranch}" FontSize="12"
                                               Foreground="{DynamicResource ThemeAccent}"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="7" Height="7" Fill="#FFA726" VerticalAlignment="Center" Margin="5,0,0,0"
                                             Visibility="{Binding IsGitDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             ToolTip="未コミットの変更があります" />
                                    <materialDesign:PackIcon Kind="MenuDown" Width="13" Height="13"
                                                             Foreground="{DynamicResource ThemeAccent}"
                                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <ListBox ItemsSource="{Binding Branches}"
                                     Background="{DynamicResource MaterialDesignPaper}"
                                     BorderThickness="0"
                                     MaxHeight="200">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SwitchBranchCommand, Source={x:Reference BranchPopupBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="30" Padding="12,0" FontSize="12"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </materialDesign:PopupBox>
                        <!-- Git operation buttons -->
                        <Button Command="{Binding GitFetchCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Fetch" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GitPullCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowDown" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pull" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GitPushCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowUp" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Push" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenGithubPageCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Github" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Repo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SelectedProject.BuildCommand, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ビルドコマンド"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 FontSize="13"
                                 LostFocus="OnSettingsFieldLostFocus" />

                        <TextBox Grid.Column="2"
                                 Text="{Binding SelectedProject.LaunchCommand, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="起動コマンド"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 FontSize="13"
                                 LostFocus="OnSettingsFieldLostFocus" />
                    </Grid>

                    <!-- Hidden anchor for ContextMenu binding -->
                    <FrameworkElement x:Name="ActionAnchor" Visibility="Collapsed" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Command="{Binding BuildCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Hammer" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="ビルド" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LaunchCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource ThemeAccent}"
                                Height="30" Padding="10,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="15" Height="15"
                                                         Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="起動" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="フォルダを開く" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="15" Height="15" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>

                        <Button Command="{Binding OpenPowerShellCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="PowerShellを開く" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="Console" Width="15" Height="15" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>

                        <Button Command="{Binding AddActionCommand}"
                                Style="{StaticResource MaterialDesignToolButton}"
                                ToolTip="アクション追加" Width="28" Height="28" Margin="2,0,0,0">
                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource ThemeSubText}" />
                        </Button>

                        <ItemsControl ItemsSource="{Binding SelectedProject.Actions}" Margin="4,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="30" Padding="10,0" FontSize="12">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="設定"
                                                          Command="{Binding DataContext.EditActionCommand, Source={x:Reference ActionAnchor}}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="Cog" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="削除"
                                                          Command="{Binding DataContext.DeleteActionCommand, Source={x:Reference ActionAnchor}}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="Delete" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <Separator Background="{DynamicResource ThemeSplitter}" Margin="0,0,0,0" />
                </StackPanel>

                <!-- Output Log -->
                <DockPanel Grid.Row="1" Margin="14,4,14,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="出力" FontSize="12" Foreground="{DynamicResource ThemeMutedText}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Value="0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Width="14" Height="14" Margin="0,0,6,0" />
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding CancelOperationCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="中止" Width="22" Height="22">
                                <materialDesign:PackIcon Kind="Stop" Width="13" Height="13" Foreground="#C62828" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding ClearLogCommand}"
                                    ToolTip="クリア" Width="22" Height="22">
                                <materialDesign:PackIcon Kind="DeleteSweep" Width="13" Height="13" Foreground="{DynamicResource ThemeMutedText}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <RichTextBox x:Name="OutputLogBox"
                                 Style="{x:Null}"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="{DynamicResource ThemeOutput}"
                                 Foreground="{DynamicResource ThemeOutputForeground}"
                                 BorderBrush="{DynamicResource ThemeBorder}"
                                 BorderThickness="1"
                                 Padding="8,6">
                        <FlowDocument PagePadding="0" />
                    </RichTextBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
    </materialDesign:DialogHost>
</Window>
