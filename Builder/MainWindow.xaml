<Window x:Class="Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Builder.ViewModels"
        Title="Builder"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="500"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#1E1E1E"
        FontFamily="{materialDesign:MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Project List -->
        <DockPanel Grid.Column="0" Background="#252526">
            <DockPanel DockPanel.Dock="Top" Margin="10,8">
                <TextBlock Text="プロジェクト" FontSize="13" FontWeight="Medium"
                           Foreground="#999" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding AddProjectCommand}"
                            ToolTip="追加" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="#999" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding RemoveProjectCommand}"
                            ToolTip="削除" Width="26" Height="26" Margin="2,0,0,0">
                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" Foreground="#999" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <ListBox ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}"
                     Background="Transparent" BorderThickness="0"
                     Padding="4,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" />
                            <TextBlock Text="{Binding FolderPath}" FontSize="10.5"
                                       Foreground="#666" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="1" Background="#333" />

        <!-- Right -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Settings -->
            <StackPanel Grid.Row="0" Margin="14,12,14,4"
                        Visibility="{Binding HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedProject.BuildCommand, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="ビルドコマンド"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="13" Margin="0,0,0,6"
                             LostFocus="OnSettingsFieldLostFocus" />

                    <TextBox Grid.Column="2"
                             Text="{Binding SelectedProject.LaunchCommand, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="起動コマンド"
                             materialDesign:HintAssist.IsFloating="True"
                             FontSize="13" Margin="0,0,0,6"
                             LostFocus="OnSettingsFieldLostFocus" />
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <Button Command="{Binding GitPullCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="30" Padding="10,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SourceBranch" Width="15" Height="15"
                                                     Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pull" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BuildCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="30" Padding="10,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Hammer" Width="15" Height="15"
                                                     Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="ビルド" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LaunchCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#4FC3F7"
                            Height="30" Padding="10,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="15" Height="15"
                                                     Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="起動" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource MaterialDesignToolButton}"
                            ToolTip="フォルダを開く" Width="28" Height="28">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="15" Height="15" Foreground="#888" />
                    </Button>

                </StackPanel>

                <Separator Background="#333" Margin="0,0,0,0" />
            </StackPanel>

            <!-- Output Log -->
            <DockPanel Grid.Row="1" Margin="14,4,14,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="出力" FontSize="12" Foreground="#666"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Value="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Width="14" Height="14" Margin="0,0,6,0" />
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding CancelOperationCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="中止" Width="22" Height="22">
                            <materialDesign:PackIcon Kind="Stop" Width="13" Height="13" Foreground="#C62828" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding ClearLogCommand}"
                                ToolTip="クリア" Width="22" Height="22">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="13" Height="13" Foreground="#666" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <TextBox Text="{Binding OutputLog, Mode=OneWay}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Background="#1A1A1A"
                         Foreground="#CCC"
                         BorderBrush="#333"
                         BorderThickness="1"
                         Padding="8,6" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
