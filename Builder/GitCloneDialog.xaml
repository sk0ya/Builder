<UserControl x:Class="Builder.GitCloneDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:Card Width="500" Padding="28,24"
                         Background="{DynamicResource MaterialDesignPaper}"
                         UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="6"
                        Background="{DynamicResource ThemeAccent}">
                    <materialDesign:PackIcon Kind="Github" Width="18" Height="18"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="White" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GitHubからクローン"
                               FontSize="15" FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock Text="リポジトリをクローンしてプロジェクトに追加します"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeMutedText}" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Separator Grid.Row="2" Background="{DynamicResource ThemeSplitter}" />

            <!-- URL Label -->
            <TextBlock Grid.Row="4"
                       Text="リポジトリURL"
                       FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeSubText}" />

            <!-- URL Field -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlBox"
                         Grid.Column="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="https://github.com/user/repository"
                         materialDesign:HintAssist.IsFloating="False"
                         FontSize="13"
                         FontFamily="Consolas"
                         TextChanged="UrlBox_TextChanged" />

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="PasteUrl_Click"
                        ToolTip="クリップボードから貼り付け"
                        Height="44" Padding="10,0" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentPaste" Width="14" Height="14"
                                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="貼付" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Parent Folder Label -->
            <TextBlock Grid.Row="8"
                       Text="クローン先（親フォルダ）"
                       FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource ThemeSubText}" />

            <!-- Parent Folder Field -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ParentPathBox"
                         Grid.Column="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="親フォルダを入力または参照..."
                         materialDesign:HintAssist.IsFloating="False"
                         FontSize="13"
                         FontFamily="Consolas"
                         TextChanged="ParentPathBox_TextChanged" />

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="BrowseFolder_Click"
                        ToolTip="フォルダを選択"
                        Height="44" Padding="10,0" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14"
                                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="参照" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Clone destination preview -->
            <Border Grid.Row="12"
                    Background="{DynamicResource ThemeOutput}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderArrowRight" Width="14" Height="14"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource ThemeSubText}"
                                             Margin="0,0,6,0" />
                    <TextBlock x:Name="ClonePathPreview"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource ThemeMutedText}"
                               Text="URLを入力するとクローン先が表示されます"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Error Text -->
            <TextBlock x:Name="ErrorText"
                       Grid.Row="13"
                       Foreground="#EF5350"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />

            <!-- Buttons -->
            <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}"
                        Height="36" Padding="16,0" FontSize="13"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource ThemeAccent}"
                        Click="OnClone"
                        Height="36" Padding="16,0" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SourceBranchSync" Width="15" Height="15"
                                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="クローン" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
