<UserControl x:Class="Builder.GroupManagementDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Builder">

    <materialDesign:Card Width="500" Padding="24"
                         Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="グループ管理"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBody}" />

            <!-- Header row -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="プロジェクト"
                           FontSize="11" Foreground="{DynamicResource ThemeMutedText}" />
                <TextBlock Grid.Column="1" Text="グループ"
                           FontSize="11" Foreground="{DynamicResource ThemeMutedText}" Margin="8,0,0,0" />
            </Grid>

            <Separator Grid.Row="3" Background="{DynamicResource ThemeSplitter}" />

            <!-- Project list -->
            <ScrollViewer Grid.Row="4" MaxHeight="360"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProjectList" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{Binding Project.IconKind}"
                                                             Width="14" Height="14"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,7,0"
                                                             Foreground="{DynamicResource ThemeSubText}" />
                                    <TextBlock Text="{Binding Project.Name}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          IsEditable="True"
                                          Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          materialDesign:HintAssist.Hint="グループなし"
                                          FontSize="12"
                                          Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Separator Grid.Row="5" Background="{DynamicResource ThemeSplitter}" Margin="0,4" />

            <!-- New group hint -->
            <TextBlock Grid.Row="6"
                       Text="コンボボックスに直接入力して新しいグループを作成できます。空にするとグループなし。"
                       FontSize="10"
                       Foreground="{DynamicResource ThemeMutedText}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}"
                        Margin="0,0,8,0" />
                <Button Content="OK"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#4FC3F7"
                        Click="OnOk" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
