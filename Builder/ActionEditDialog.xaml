<UserControl x:Class="Builder.ActionEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <materialDesign:Card Width="460" Padding="24"
                         Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="160" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="アクション設定"
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBody}" />

            <TextBox x:Name="NameBox"
                     Grid.Row="2"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="名前"
                     materialDesign:HintAssist.IsFloating="True"
                     FontSize="13" />

            <TextBox x:Name="ScriptBox"
                     Grid.Row="4"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="アクション (PowerShell)"
                     materialDesign:HintAssist.IsFloating="True"
                     FontSize="12"
                     FontFamily="Consolas"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="6"
                       Text="名前を入力してください。"
                       Foreground="#EF5350"
                       FontSize="11"
                       Visibility="Collapsed" />

            <CheckBox x:Name="LaunchOnlyCheck"
                      Grid.Row="8"
                      Content="プロセスの起動のみ（出力なし）"
                      FontSize="12"
                      Foreground="{DynamicResource MaterialDesignBody}" />

            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}"
                        Margin="0,0,8,0" />
                <Button Content="OK"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#4FC3F7"
                        Click="OnOk" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
